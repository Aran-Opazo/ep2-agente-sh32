# Copiar a .env (nunca subir .env al repositorio).
# Por defecto el notebook usa Groq con qwen (si LLM_BASE_URL y LLM_MODEL no se definen).
LLM_API_KEY=tu_key_de_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Alternativa Mistral (rama del curso; útil si se agota la cuota diaria de Groq):
# LLM_API_KEY=tu_key_de_mistral
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
